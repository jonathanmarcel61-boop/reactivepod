<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Antes esto apuntaba a la raíz completa (path=".") del almacenamiento
      externo y de la caché, lo cual comparte más de lo necesario si algún
      día se usa este proveedor. Hoy ninguna función de la app lo usa
      todavía (no hay cámara ni compartir archivos conectado), así que se
      deja acotado a una subcarpeta específica para cuando se necesite.
    -->
    <cache-path name="rehabpod_compartido" path="compartido/" />
    <external-files-path name="rehabpod_exportados" path="exportados/" />
</paths>
