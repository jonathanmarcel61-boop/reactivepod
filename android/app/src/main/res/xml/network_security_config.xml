<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Configuración base para toda la app:
      - cleartextTrafficPermitted="false": bloquea cualquier conexión HTTP
        sin cifrar. Toda comunicación (Supabase, assets, etc.) debe ir por
        HTTPS.
      - Solo se confía en las autoridades certificadoras del sistema, NO en
        certificados que el usuario (o alguien con acceso al celular) haya
        instalado manualmente. Esto evita que una CA maliciosa instalada en
        el dispositivo pueda interceptar el tráfico de la app (ataque de
        intermediario / MITM), incluso en redes Wi-Fi no confiables.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
